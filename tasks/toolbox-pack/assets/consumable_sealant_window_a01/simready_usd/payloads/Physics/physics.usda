        )
        {
        }
    }

    over "PhysicsMaterials"
    {
        over "physics_mat_m_opaque__metal__consumableAdhesives_a01" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:density = 2700
            float physics:dynamicFriction = 1.2
            float physics:restitution = 0.4
            float physics:staticFriction = 1.2
        }

        over "physics_mat_m_opaque__plastic__consumableAdhesives_a01" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:density = 950
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0.4
            float physics:staticFriction = 0.4
        }
    }

    over "Joints"
    {
        def PhysicsFixedJoint "joint_cap_01_joint_00"
        {
            custom rel physics:body0
            prepend rel physics:body0 = </RootNode/Geometry/tube_01_obj_00/tube_01_mesh_00>
            custom rel physics:body1
            prepend rel physics:body1 = </RootNode/Geometry/cap_01_obj_00/cap_01_mesh_00>
            float physics:breakForce = inf
            float physics:breakTorque = inf
            point3f physics:localPos0 = (0.028020797, -3.0455254e-8, 0.011680433)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
        }
    }
