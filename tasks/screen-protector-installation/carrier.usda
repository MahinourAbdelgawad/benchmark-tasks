#usda 1.0
(
    defaultPrim = "Body"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Body" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.025

    def Cube "vacuum_pad" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </Body/Materials/vacuum_pad>
        custom float physxCollision:contactOffset = 0.0003
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.026, 0.03, 0.003)
        double3 xformOp:translate = (0, 0, 0.0015)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def "Materials"
    {
        def Material "vacuum_pad" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Body/Materials/vacuum_pad/Surface.outputs:surface>
            float physics:dynamicFriction = 0.6
            float physics:staticFriction = 0.6

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.025, 0.03, 0.04)
                token outputs:surface
            }
        }

        def Material "handle" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Body/Materials/handle/Surface.outputs:surface>
            float physics:dynamicFriction = 1
            float physics:staticFriction = 1

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.34, 0.36)
                token outputs:surface
            }
        }
    }

    def Cube "handle" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </Body/Materials/handle>
        custom float physxCollision:contactOffset = 0.0003
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.026, 0.012, 0.034)
        double3 xformOp:translate = (0, 0, 0.019)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

