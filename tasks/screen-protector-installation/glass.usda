#usda 1.0
(
    defaultPrim = "Body"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Body" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.018

    def Cube "protector" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </Body/Materials/protector>
        custom float physxCollision:contactOffset = 0.0003
        custom float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.07, 0.145, 0.0016)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def "Materials"
    {
        def Material "protector" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Body/Materials/protector/Surface.outputs:surface>
            float physics:dynamicFriction = 0.3
            float physics:staticFriction = 0.3

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.04, 0.15, 0.21)
                float inputs:opacity = 0.45
                float inputs:roughness = 0.14
                token outputs:surface
            }
        }
    }
}

